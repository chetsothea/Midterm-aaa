# PS168 API — settings for the live server.
# Copy to .env on the server, fill in the blanks, then run:
#   php artisan key:generate && php artisan shop:check-production
# Never commit the real .env.

APP_NAME=PS168
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

# Behind nginx/Cloudflare on the same machine
TRUSTED_PROXIES=127.0.0.1
# The Flutter web shop's address (phone apps don't need this). Comma-separated.
CORS_ALLOWED_ORIGINS=https://your-domain.com

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# MySQL (recommended live). SQLite also works for a small shop:
#   DB_CONNECTION=sqlite  (and remove the DB_* lines below)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phoneshop
DB_USERNAME=phoneshop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail for "forgot password" codes. Gmail: turn on 2-step verification,
# then make an App Password (16 letters) and put it in MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PS168

# Shown to customers
SHOP_TELEGRAM=
SHOP_UNPAID_MINUTES=30

# Bakong KHQR auto-check (leave empty to check payments by hand)
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=PS168
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_CURRENCY=USD

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
